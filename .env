
# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://achinthahost3000:xyx500@host3000.7qkcxhk.mongodb.net/electro_wav?retryWrites=true&w=majority

# Logger level (info, warn, error, debug)
LOG_LEVEL=info


# ----------------------
# App settings
# ----------------------
NODE_ENV=development      

-------------------
# Security / Auth
# ----------------------
JWT_SECRET=supersecretjwtkey123          # Access token secret
JWT_EXPIRES_IN=15m                       # Access token expiry
REFRESH_TOKEN_SECRET=superrefreshkey456  # Refresh token secret
REFRESH_TOKEN_EXPIRES_IN=7d              # Refresh token expiry

# Crypto key for AES encryption/decryption in AuthService
CRYPTO_SECRET_KEY=mysupercryptokey789

# JWT metadata
JWT_ISSUER=hotel-management-api
JWT_AUDIENCE=hotel-management-users

# ----------------------
# Bcrypt settings
# ----------------------
BCRYPT_ROUNDS=12                    # Higher = more secure but slower

# ----------------------
# Account lockout policy
# ----------------------
MAX_LOGIN_ATTEMPTS=5                # Failed attempts before lock
ACCOUNT_LOCK_TIME=7200000           # 2 hours in ms

# ----------------------
# Email (for password reset / verification)
# ----------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@example.com
SMTP_PASS=yourpassword
EMAIL_FROM="My App <no-reply@myapp.com>"
EMAIL_VERIFY_URL=http://localhost:5000/api/auth/verify-email
PASSWORD_RESET_URL=http://localhost:5000/api/auth/reset-password

# ----------------------
# Logging files
# ----------------------
LOG_DIR=logs

